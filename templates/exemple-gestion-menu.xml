<?xml version="1.0" encoding="UTF-8"?>
<template id="admin-to-site-editor" title="Gestionnaire de menu WordPress" context="admin">
  <steps>
    <step selector="body" position="left">
      <title>Menu Apparence</title>
      <description>Ouvrez le menu Apparence pour accéder à l’éditeur du site. &lt;img src=&quot;https://picsum.photos/id/237/1900/800&quot; alt=&quot;Lorem Picsum&quot;/&gt;</description>
      <action>click</action>
      <wait_for>a[href*=&quot;site-editor.php&quot;]</wait_for>
      <wait_timeout>0</wait_timeout>
      <delay_ms>200</delay_ms>
      <resume>none</resume>
    </step>
    <step selector="a[href*=&#039;site-editor.php&#039;]" position="right">
      <title>Éditeur du site</title>
      <description>Cliquez pour ouvrir l’éditeur du site.</description>
      <action>click</action>
      <wait_timeout>0</wait_timeout>
      <delay_ms>0</delay_ms>
      <resume>auto</resume>
    </step>
    <step selector=".navigation-navigation-item" position="right">
      <title>Navigation</title>
      <description>Voici l’élément de navigation dans l’éditeur du site.</description>
      <action>none</action>
      <wait_for>.navigation-navigation-item</wait_for>
      <wait_timeout>0</wait_timeout>
      <delay_ms>0</delay_ms>
      <resume>none</resume>
    </step>
  </steps>
</template>
