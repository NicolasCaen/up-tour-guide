<?xml version="1.0" encoding="UTF-8"?>
<template id="transformer-paragraphe-en-puces" title="Transformer un paragraphe en puces" context="editor">
  <steps>
    <step selector=".block-editor-block-list__layout .wp-block-paragraph, [data-type='core/paragraph']" position="right">
      <title>Sélectionner un paragraphe</title>
      <description>Cliquez sur un bloc Paragraphe existant.</description>
    </step>
    <step selector=".block-editor-block-switcher__toggle, button[aria-label='Changer de type de bloc']" position="bottom">
      <title>Changer le type</title>
      <description>Ouvrez le menu pour transformer le bloc.</description>
    </step>
    <step selector=".components-menu-item__button[aria-label='Liste'], .block-editor-block-types-list__item[aria-label='Liste']" position="right">
      <title>Transformer en Liste</title>
      <description>Transformez le paragraphe en une liste à puces.</description>
    </step>
  </steps>
</template>
